# Copy to `.env` and edit. All values are optional.

# Path to your Logseq graph. Defaults to ../logseq_notes (sibling of this folder).
# LOGSEQ_NOTES_ROOT=/absolute/path/to/your/logseq/graph

# Graph name used when constructing logseq:// links.
# Defaults to the basename of LOGSEQ_NOTES_ROOT.
# LOGSEQ_GRAPH_NAME=my-graph

# Logseq journal page title format. Must match your Logseq setting.
# Quote any value that contains a space or comma.
# LOGSEQ_JOURNAL_TITLE_FORMAT="EEE, dd-MM-yyyy"

# Git behaviour after each mutation.
# LOGSEQ_GIT_AUTO_COMMIT=1
# LOGSEQ_GIT_AUTO_PUSH=1

# Background `git pull --rebase` interval in seconds.
# LOGSEQ_GIT_PULL_INTERVAL=120

# Network interface and port for uvicorn.
# 127.0.0.1 = localhost only.
# 0.0.0.0   = all interfaces (LAN, Tailscale, etc.). Only safe on a trusted network.
# HOST=0.0.0.0
# PORT=8765
